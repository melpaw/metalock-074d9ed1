# ============================================================
# MetaLock — environment variables
# Copy this file to `.env` and fill in the values for your
# Supabase project. Keys prefixed with VITE_ are exposed to the
# browser bundle; keep server-only keys unprefixed.
# ============================================================

# ---- Supabase (client + SSR) ----
# Project reference (the subdomain of your *.supabase.co URL)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PROJECT_ID="your-project-ref"

# Full REST URL of the Supabase project
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Anon / publishable key — safe to ship in the browser bundle
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."

# ---- Server-only ----
# Service role key. NEVER expose to the browser. Only used by
# server functions / edge functions that must bypass RLS.
# On Lovable Cloud this is injected automatically and is not
# available in the dashboard. When running outside Lovable, copy
# it from Supabase Dashboard → Project Settings → API.
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ---- Optional ----
# Base URL used for absolute links (canonical, og:url, sitemap).
# VITE_SITE_URL="https://metalock.example.com"
